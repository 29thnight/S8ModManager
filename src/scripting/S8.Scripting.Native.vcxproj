<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><ProjectGuid>{38C56361-7252-4CB5-87D5-B9059B473DEC}</ProjectGuid><WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType><PlatformToolset>v145</PlatformToolset><VCToolsVersion>14.51.36231</VCToolsVersion><CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries><UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\..\build\S8.Cpp23.props" />
  <PropertyGroup>
    <!-- The mod manager is its own proxy entry; the cheat proxies are hid/dxgi/dinput8. -->
    <TargetName>xinput1_4</TargetName>
    <S8EditorsModDir>$(MSBuildThisFileDirectory)..\..\out\$(Platform)\$(Configuration)\scripts\mods\s8.editors\</S8EditorsModDir>
    <OutDir>$(MSBuildThisFileDirectory)..\..\out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\out\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <DotNetHostPack Condition="'$(DotNetHostPack)'==''">$(ProgramW6432)\dotnet\packs\Microsoft.NETCore.App.Host.win-x64\10.0.14\runtimes\win-x64\native</DotNetHostPack>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>$(DotNetHostPack);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile>
    <Link><AdditionalDependencies>$(DotNetHostPack)\nethost.lib;Advapi32.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="native_ui.cpp" />
    <ClCompile Include="native_ui_input.cpp" />
    <ClInclude Include="native_ui.h" />
    <ClInclude Include="native_ui_input.h" />
    <None Include="native_ui_api.inl" />
    <None Include="native_tree.inl" />
    <None Include="native_window.inl" />
    <None Include="native_menus.inl" />
    <None Include="native_ui_services.inl" />
    <ClCompile Include="script_host.cpp" />
    <ClCompile Include="mod_entry.cpp" />
    <ClCompile Include="mod_registry.cpp" />
    <ClCompile Include="jewel_services.cpp" />
    <ClInclude Include="mod_registry.h" />
    <ClCompile Include="game_binding.cpp" />
    <ClCompile Include="engine_services.cpp" />
    <ClInclude Include="script_api.h" />
    <ClInclude Include="engine_services.h" />
  </ItemGroup>
  <!-- Copied from the S8RPKCheats repository so this repository builds on its own. -->
  <ItemGroup>
    <ClCompile Include="..\game\jewel_open.cpp" />
    <ClCompile Include="..\game\secondary_jewel_hook.cpp" />
    <ClCompile Include="..\domain\secondary_jewel.cpp" />
    <ClCompile Include="..\platform\windows\hook.cpp" />
    <ClCompile Include="..\platform\windows\process_memory.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\platform\windows\S8.MinHook.vcxproj"><Project>{CFD9C034-41D1-4619-8D9C-2539C7F19F4C}</Project></ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Layout: scripts\ holds the JIT host and SDK; scripts\mods\<folder>\mod.json declares each mod. -->
  <Target Name="BuildManagedScripts" AfterTargets="Build">
    <Copy SourceFiles="$(DotNetHostPack)\nethost.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)managed\S8.GameScripts\mod.json" DestinationFolder="$(S8EditorsModDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\resources\effect_definitions.json" DestinationFolder="$(S8EditorsModDir)assets" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\resources\jewel_definitions.json" DestinationFolder="$(S8EditorsModDir)assets" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)managed\S8.Scripting.Host\S8.Scripting.Host.csproj&quot; -c $(Configuration) -o &quot;$(OutDir)scripts&quot; --nologo" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)managed\S8.GameScripts\S8.GameScripts.csproj&quot; -c $(Configuration) -o &quot;$(S8EditorsModDir.TrimEnd('\'))&quot; --nologo" />
  </Target>
</Project>
